# Docker Compose local runtime
BIND_HOST=127.0.0.1
POSTGRES_DB=gentrip
POSTGRES_USER=gentrip
POSTGRES_PASSWORD=gentrip
POSTGRES_PORT=5432
REDIS_PORT=6379
API_PORT=8080
PROMETHEUS_PORT=9090
HTTP_PORT=80
HTTPS_PORT=443
# Production hostname. Example: gentrip.203-0-113-10.sslip.io
APP_DOMAIN=localhost
PRODUCTION_ALLOW_REGISTRATION=false
DATABASE_URL=postgresql://gentrip:gentrip@127.0.0.1:5432/gentrip
REDIS_URL=redis://127.0.0.1:6379/0
RUNTIME_SESSION_CACHE_TTL_SECONDS=86400
ROUTE_BUNDLE_CACHE_TTL_SECONDS=1800
ROUTE_BUNDLE_MIN_MATCH_SCORE=0.85

# Production tenant identity. Example: {"replace-with-long-secret":"tenant-a"}
# Once configured, X-API-Key is required and request tenant_id is ignored.
TENANT_API_KEYS_JSON=
ALLOW_INSECURE_TENANT_ID=true

# Local account authentication. Set AUTH_ENABLED=true outside local development
# and replace AUTH_JWT_SECRET with a random value of at least 32 characters.
AUTH_ENABLED=false
AUTH_JWT_SECRET=
AUTH_ACCESS_TOKEN_MINUTES=60
AUTH_COOKIE_SECURE=false
AUTH_ALLOW_REGISTRATION=true
AUTH_LOGIN_RATE_LIMIT_ENABLED=false
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_WINDOW_SECONDS=900
TRAVEL_TIME_PROVIDER=amap
TRAVEL_TIME_HTTP_URL=
TRAVEL_TIME_TIMEOUT_SEC=2

# POI source: amap for live data, postgis for imported local data, mock for
# deterministic tests/offline demos. Never commit the real key.
POI_PROVIDER=postgis
AMAP_API_KEY=
AMAP_BASE_URL=https://restapi.amap.com
AMAP_CITY=上海
AMAP_TIMEOUT_SEC=5
AMAP_POI_CACHE_TTL_SECONDS=900
AMAP_POI_MAX_QUERIES=8
POI_SLOT_PARALLEL_ENABLED=true
POI_SLOT_CONCURRENCY=2
POI_QUERIES_PER_SLOT=4
POI_QUERIES_PER_RUN=16
AMAP_MIN_REQUEST_INTERVAL_SEC=0.25
AMAP_MAX_RETRIES=2
AMAP_RETRY_BASE_SECONDS=0.35

# Set redis_stream only when the worker service is running.
RUNTIME_EXECUTION_MODE=inprocess
RUNTIME_QUEUE_STREAM=gentrip:plan-runs
RUNTIME_QUEUE_GROUP=gentrip-plan-workers
RUNTIME_QUEUE_CLAIM_IDLE_MS=150000
RUNTIME_QUEUE_HEARTBEAT_MS=30000
RUNTIME_RUN_DEADLINE_SECONDS=120
RUNTIME_TENANT_MAX_ACTIVE_RUNS=3
RUNTIME_QUEUE_MAX_ATTEMPTS=3
RUNTIME_QUEUE_DEAD_LETTER_STREAM=gentrip:plan-runs:dlq

# Optional OTLP trace export. Leave empty to retain trace context without exporting.
OTEL_SERVICE_NAME=gentrip-api
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=

# Fixture data is imported into the local PostGIS instance with:
# docker compose exec api python scripts/import_poi_fixture.py

# Keep false for deterministic local smoke tests. Add a real key only to .env.
LLM_ENABLED=false
LLM_API_KEY=
DEEPSEEK_API_KEY=
LLM_MODEL=deepseek-v4-pro
LLM_FAST_MODEL=deepseek-v4-flash
LLM_DISABLE_THINKING=true
LLM_FAST_TIMEOUT_SEC=12
LLM_ROUTE_EVALUATE_TIMEOUT_SEC=15
PLANNER_BLUEPRINT_ENABLED=false
TURN_ROUTER_V2_ENABLED=true
CONSTRAINT_COMPILER_ENABLED=true
BLUEPRINT_FEASIBILITY_ENABLED=true
JOINT_ROUTE_SOLVER_ENABLED=true
FAILURE_DIRECTED_REPAIR_ENABLED=true
ACTIVITY_BLUEPRINT_MODE=llm_with_fallback
ACTIVITY_BLUEPRINT_COUNT=2
ROUTE_EVALUATE_MODE=llm_with_fallback
SESSION_SUMMARY_MODE=async_llm
