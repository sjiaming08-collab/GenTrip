http://{$APP_DOMAIN:localhost} {
    encode zstd gzip

    handle /healthz {
        respond "ok" 200
    }

    handle /api/* {
        reverse_proxy api:8080 {
            flush_interval -1
        }
    }

    handle {
        root * /srv
        try_files {path} /index.html
        file_server
    }
}
