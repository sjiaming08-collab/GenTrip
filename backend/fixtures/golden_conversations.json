[
  {
    "id": "xuhui_afternoon_exclusion_and_add",
    "description": "下午看展喝咖啡后，用户否定咖啡，再追加火锅。验证约束、删除语义和局部追加。",
    "turns": [
      {
        "query": "徐汇区下午两点看展览再喝咖啡，18点前回，人均150",
        "expect": {
          "turn_mode": "plan",
          "plan_path": "cold",
          "constraints": {"district": "徐汇区", "budget_per_person": 150, "start_at": "14:00", "return_by": "18:00"},
          "required_categories": ["咖啡", "博物馆"],
          "min_stops": 2,
          "quality": {"min_score": 70, "min_avg_rating": 3.8, "max_leg_travel_min": 35, "require_unique_pois": true}
        }
      },
      {
        "query": "我不想喝咖啡",
        "expect": {
          "turn_mode": "replan",
          "reply_type": "diff",
          "forbidden_categories": ["咖啡"],
          "diff_change_types": ["removed"],
          "quality": {"min_score": 70, "max_leg_travel_min": 35, "require_unique_pois": true}
        }
      },
      {
        "query": "再加一家火锅",
        "expect": {
          "turn_mode": "replan",
          "reply_type": "degraded_route",
          "planning_outcome": "change_rejected",
          "forbidden_categories": ["咖啡"],
          "quality": {"min_score": 70, "max_leg_travel_min": 35, "require_unique_pois": true}
        }
      }
    ]
  },
